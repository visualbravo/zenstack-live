{
  "name": "simple",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run --parallel ./src/index.ts ./src/index.ts",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "zen:generate": "zen generate",
    "zen:db:push": "zen db push",
    "zen:studio": "zen studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@visualbravo/zenstack-live": "workspace:*",
    "@zenstackhq/orm": "catalog:",
    "bottleneck": "^2.19.5",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "@zenstack-live/config": "workspace:*",
    "@zenstackhq/cli": "catalog:",
    "@zenstackhq/schema": "catalog:"
  },
  "zenstack": {
    "schema": "./src/schema.zmodel",
    "output": "./src"
  },
  "packageManager": "bun@1.4.4"
}
