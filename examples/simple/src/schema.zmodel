datasource db {
  provider = 'postgresql'
}

model User {
  id            String     @id @default(cuid())
  string        String?
  stringArray   String[]
  boolean       Boolean?
  booleanArray  Boolean[]
  int           Int?
  intArray      Int[]
  float         Float?
  floatArray    Float[]
  dateTime      DateTime?
  dateTimeArray DateTime[]
  bigInt        BigInt?
  bigIntArray   BigInt[]
  decimal       Decimal?
  decimalArray  Decimal[]
  enum          Role
  // enumArray     Role[]
  json          Meta?      @json
  jsonArray     Meta[]     @json
  posts         Post[]
}

model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String
  published Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
}

type Meta {
  string       String?
  stringArray  String[]
  boolean      Boolean?
  booleanArray Boolean[]
  int          Int?
  intArray     Int[]
  float        Float?
  floatArray   Float[]
  dateTime      DateTime?
  dateTimeArray DateTime[]
  // bigInt        BigInt?
  // bigIntArray   BigInt[]
  // decimal       Decimal?
  // decimalArray  Decimal[]
  enum         Role
  // enumArray    Role[]
  // json          Meta?      @json
  // jsonArray     Meta[]     @json
}

enum Role {
  USER
  ADMIN
}