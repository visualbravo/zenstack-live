{
  "name": "@visualbravo/zenstack-live",
  "version": "0.0.0",
  "keywords": [
    "live",
    "orm",
    "prisma",
    "pulse",
    "realtime",
    "streaming",
    "websocket",
    "zenstack"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "@zenstack-live/source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./event-discriminator": {
      "@zenstack-live/source": "./src/event-discriminator.ts",
      "import": "./dist/event-discriminator.mjs",
      "require": "./dist/event-discriminator.cjs"
    },
    "./internal": {
      "@zenstack-live/source": "./src/internal.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.cjs"
    },
    "./query-compiler": {
      "@zenstack-live/source": "./src/query-compiler.ts",
      "import": "./dist/query-compiler.mjs",
      "require": "./dist/query-compiler.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./event-discriminator": {
        "import": "./dist/event-discriminator.mjs",
        "require": "./dist/event-discriminator.cjs"
      },
      "./internal": {
        "import": "./dist/internal.mjs",
        "require": "./dist/internal.cjs"
      },
      "./query-compiler": {
        "import": "./dist/query-compiler.mjs",
        "require": "./dist/query-compiler.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "format:fix": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "decimal.js": "catalog:",
    "ioredis": "catalog:",
    "lossless-json": "^4.0.1",
    "stable-hash": "^0.0.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "@zenstack-live/config": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:"
  },
  "peerDependencies": {
    "@zenstackhq/orm": "catalog:",
    "@zenstackhq/schema": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
